{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/states.test.ts",
    "lib/ledgerLine.test.ts",
    "lib/server/record.test.ts",
    "lib/sign.test.ts",
    "lib/server/receipt.test.ts",
    "lib/server/calldata.test.ts",
    "lib/minCurve.test.ts",
    "lib/agentId.test.ts",
    "lib/seatPhase.test.ts"
  ]
}
